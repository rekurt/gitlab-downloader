{
  "name": "gitlab-dump-desktop",
  "version": "0.2.0",
  "description": "Desktop application for GitLab repository management and migration",
  "main": "main.js",
  "homepage": "./",
  "author": "GitLab Dump Team",
  "license": "MIT",
  "scripts": {
    "start": "concurrently \"npm run webpack-dev\" \"npm run electron-dev\"",
    "dev": "concurrently \"npm run webpack-dev\" \"npm run electron-dev\"",
    "webpack-dev": "webpack serve --mode development",
    "electron-dev": "wait-on http://localhost:8000 && electron . --remote-debugging-port=9222",
    "build": "webpack --mode production",
    "pack": "electron-builder --config electron-builder.config.js --dir",
    "dist": "npm run build && electron-builder --config electron-builder.config.js",
    "dist-win": "npm run build && electron-builder --config electron-builder.config.js --win",
    "dist-mac": "npm run build && electron-builder --config electron-builder.config.js --mac",
    "dist-linux": "npm run build && electron-builder --config electron-builder.config.js --linux",
    "test": "node ../node_modules/jest/bin/jest.js --config jest.config.js",
    "test:coverage": "node ../node_modules/jest/bin/jest.js --config jest.config.js --coverage",
    "lint": "eslint main.js preload.js src __tests__ webpack.config.js electron-builder.config.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@gitlab-dump/core": "0.2.0",
    "electron-store": "11.0.2"
  },
  "devDependencies": {
    "@ant-design/icons": "6.3.2",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@jest/globals": "30.4.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "antd": "6.6.1",
    "autoprefixer": "10.5.4",
    "babel-jest": "30.4.1",
    "babel-loader": "9.2.1",
    "concurrently": "10.0.6",
    "css-loader": "7.1.4",
    "electron": "43.7.9",
    "electron-builder": "26.15.7",
    "html-webpack-plugin": "5.6.8",
    "jest-environment-jsdom": "30.4.1",
    "postcss": "8.5.26",
    "postcss-loader": "8.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "style-loader": "4.0.0",
    "tailwindcss": "4.3.3",
    "wait-on": "9.1.0",
    "webpack": "5.109.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.6"
  }
}
